---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Suggest a Topic — The Catalog</title>

    <meta
      name="description"
      content="Have a strange question, obscure fact, or fascinating rabbit hole? Suggest it to The Catalog."
    />
  </head>

  <body>

    <header class="site-header">
      <div class="wrap">

        <div class="brand">

          <a class="logo" href="/">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 5c-2-1.5-5-2-8-1v14c3-1 6-.5 8 1c2-1.5 5-2-8-1V4c-3-1-6-.5-8 1z" />
              <line x1="12" y1="5" x2="12" y2="19" />
            </svg>

            The Catalog
          </a>

        </div>


        <nav class="sections">

          <a href="/">Home</a>

          <a href="/discover">
            Discover
          </a>

          <a href="/rabbit-holes">
            Rabbit Holes
          </a>

          <a href="/random">
            Random
          </a>

          <a href="/about">
            About
          </a>

          <a href="/contact" class="active">
            Contact
          </a>

        </nav>

      </div>
    </header>


    <main class="wrap contact-page">

      <section class="contact-hero">

        <p class="kicker">
          got a rabbit hole?
        </p>

        <h1>
          Tell us what<br />
          we should obsess over.
        </h1>

        <p>
          Weird question? Obscure historical event?
          A fictional universe with 47 layers of lore?
          Send it our way.
        </p>

      </section>


      <section class="contact-layout">

        <div class="contact-note">

          <div class="note-tape"></div>

          <p class="note-label">
            pinned to the catalog
          </p>

          <h2>
            What makes a good suggestion?
          </h2>

          <ul>

            <li>
              Something genuinely interesting
            </li>

            <li>
              A question that sends you down a rabbit hole
            </li>

            <li>
              A bizarre piece of history
            </li>

            <li>
              A fascinating scientific mystery
            </li>

            <li>
              A book, movie, anime, or fictional universe
              worth getting lost in
            </li>

          </ul>

          <p class="note-footer">
            Basically: if you learned about it at 1 a.m.
            and immediately needed to tell someone,
            we probably want it here.
          </p>

        </div>


        <form
          class="suggestion-form"
          action="mailto:thecatalog@gmail.com"
          method="post"
          enctype="text/plain"
        >

          <div class="form-heading">

            <p class="eyebrow">
              open invitation
            </p>

            <h2>
              Suggest a rabbit hole
            </h2>

          </div>


          <label for="name">
            Your name
            <span>optional</span>
          </label>

          <input
            id="name"
            name="Name"
            type="text"
            placeholder="What should we call you?"
          />


          <label for="topic">
            What should we investigate?
          </label>

          <input
            id="topic"
            name="Topic"
            type="text"
            placeholder="e.g. The Voynich Manuscript"
            required
          />


          <label for="reason">
            Why is it interesting?
          </label>

          <textarea
            id="reason"
            name="Why"
            rows="6"
            placeholder="Give us enough information to make us curious..."
            required
          ></textarea>


          <label for="category">
            Where does it belong?
          </label>

          <select id="category" name="Category">

            <option value="Space">
              Space
            </option>

            <option value="Ocean">
              Ocean
            </option>

            <option value="History">
              History
            </option>

            <option value="Philosophy">
              Philosophy
            </option>

            <option value="Movies">
              Movies
            </option>

            <option value="Books">
              Books
            </option>

            <option value="Anime">
              Anime
            </option>

            <option value="Not sure">
              Not sure
            </option>

          </select>


          <button type="submit">
            Send it to the catalog →
          </button>

          <p class="form-disclaimer">
            Clicking submit will open your email app with
            your suggestion ready to send.
          </p>

        </form>

      </section>


      <section class="contact-bottom">

        <p class="eyebrow">
          alternatively
        </p>

        <h2>
          Just want to wander?
        </h2>

        <div class="bottom-links">

          <a href="/discover">
            Browse everything →
          </a>

          <a href="/random">
            Give me something random →
          </a>

          <a href="/rabbit-holes">
            Follow a rabbit hole →
          </a>

        </div>

      </section>

    </main>


    <footer>

      <div class="wrap">

        <p>
          The Catalog — a running catalog of curiosities.
        </p>

        <p>
          <a href="/about">About</a>
          <a href="/contact">Suggest a topic</a>
        </p>

      </div>

    </footer>

  </body>
</html>


<style>

  .contact-page {
    padding-top: 70px;
    padding-bottom: 100px;
  }


  /* HERO */

  .contact-hero {
    max-width: 760px;

    margin-bottom: 65px;
  }

  .contact-hero .kicker {
    display: inline-block;

    margin-bottom: 18px;

    padding: 5px 12px;

    background: var(--card);

    border: 2px solid var(--ink);
    border-radius: 6px;

    color: var(--ink);

    font-size: 12px;
    font-weight: 800;

    text-transform: uppercase;

    box-shadow: 4px 4px 0 var(--movies);
  }

  .contact-hero h1 {
    margin-bottom: 20px;

    font-size: clamp(43px, 6vw, 68px);

    line-height: 1;
  }

  .contact-hero > p:last-child {
    max-width: 54ch;

    margin: 0;

    color: var(--ink-dim-purple);

    font-size: 18px;
    font-weight: 600;
  }


  /* LAYOUT */

  .contact-layout {
    display: grid;

    grid-template-columns:
      .85fr 1.15fr;

    gap: 35px;

    align-items: start;

    margin-bottom: 80px;
  }


  /* NOTE */

  .contact-note {
    position: relative;

    padding: 38px 35px;

    background: var(--card-alt);

    border: 2.5px solid var(--ink);
    border-radius: 3px;

    color: var(--ink);

    box-shadow: 8px 8px 0 var(--history);

    transform: rotate(-.7deg);
  }

  .note-tape {
    position: absolute;

    top: -13px;
    left: 50%;

    width: 90px;
    height: 27px;

    background: var(--card);

    border: 1px solid rgba(58, 42, 80, .15);

    transform: translateX(-50%) rotate(2deg);

    opacity: .85;
  }

  .note-label {
    margin: 0 0 8px;

    color: var(--ink-dim-card);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: .08em;

    text-transform: uppercase;
  }

  .contact-note h2 {
    margin-bottom: 22px;

    font-size: 30px;

    line-height: 1.1;
  }

  .contact-note ul {
    margin: 0 0 25px;

    padding-left: 21px;
  }

  .contact-note li {
    margin-bottom: 11px;

    color: var(--ink-dim-card);

    font-size: 14px;
    font-weight: 600;
  }

  .note-footer {
    margin: 0;

    padding-top: 20px;

    border-top: 1px dashed rgba(58, 42, 80, .25);

    color: var(--ink);

    font-family: "Fraunces", serif;

    font-size: 16px;
    font-style: italic;
  }


  /* FORM */

  .suggestion-form {
    padding: 38px;

    background: var(--card);

    border: 2.5px solid var(--ink);
    border-radius: 10px;

    color: var(--ink);

    box-shadow: 8px 8px 0 var(--philosophy);
  }

  .form-heading {
    margin-bottom: 28px;
  }

  .form-heading .eyebrow {
    margin: 0 0 5px;

    color: var(--ink-dim-card);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: .08em;

    text-transform: uppercase;
  }

  .form-heading h2 {
    font-size: 32px;
  }


  /* LABELS */

  .suggestion-form label {
    display: flex;

    align-items: baseline;

    gap: 7px;

    margin: 18px 0 7px;

    color: var(--ink);

    font-size: 13px;
    font-weight: 800;
  }

  .suggestion-form label span {
    color: var(--ink-dim-card);

    font-size: 10px;

    font-weight: 700;
  }


  /* INPUTS */

  .suggestion-form input,
  .suggestion-form textarea,
  .suggestion-form select {
    width: 100%;

    padding: 12px 13px;

    background: var(--card-alt);

    border: 2px solid rgba(58, 42, 80, .35);
    border-radius: 6px;

    color: var(--ink);

    font-family: "Nunito", sans-serif;

    font-size: 14px;

    outline: none;
  }

  .suggestion-form textarea {
    resize: vertical;

    min-height: 130px;
  }

  .suggestion-form input:focus,
  .suggestion-form textarea:focus,
  .suggestion-form select:focus {
    border-color: var(--philosophy);

    box-shadow: 3px 3px 0 var(--philosophy);
  }

  .suggestion-form input::placeholder,
  .suggestion-form textarea::placeholder {
    color: var(--ink-dim-card);

    opacity: .7;
  }


  /* BUTTON */

  .suggestion-form button {
    width: 100%;

    margin-top: 25px;

    padding: 13px 18px;

    background: var(--ink);

    border: 2px solid var(--ink);
    border-radius: 7px;

    color: var(--card);

    font-family: "Nunito", sans-serif;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    box-shadow: 5px 5px 0 var(--movies);

    transition:
      transform .15s ease,
      box-shadow .15s ease;
  }

  .suggestion-form button:hover {
    transform: translate(-2px, -2px);

    box-shadow: 7px 7px 0 var(--movies);
  }

  .form-disclaimer {
    margin: 15px 0 0;

    color: var(--ink-dim-card);

    font-size: 11px;

    text-align: center;
  }


  /* BOTTOM */

  .contact-bottom {
    padding: 40px 45px;

    background: var(--bg-deep);

    border: 2.5px solid var(--ink);
    border-radius: 10px;

    box-shadow: 8px 8px 0 var(--ocean);
  }

  .contact-bottom .eyebrow {
    margin: 0 0 5px;

    color: var(--ink-dim-purple);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: .08em;

    text-transform: uppercase;
  }

  .contact-bottom h2 {
    margin-bottom: 22px;

    color: var(--ink-on-purple);

    font-size: 30px;
  }

  .bottom-links {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;
  }

  .bottom-links a {
    padding: 9px 13px;

    background: var(--card);

    border: 2px solid var(--ink);
    border-radius: 6px;

    color: var(--ink);

    font-size: 12px;
    font-weight: 800;

    text-decoration: none;
  }

  .bottom-links a:hover {
    transform: translate(-2px, -2px);
  }


  /* MOBILE */

  @media (max-width: 760px) {

    .contact-page {
      padding-top: 45px;
    }

    .contact-layout {
      grid-template-columns: 1fr;

      gap: 40px;
    }

    .contact-note {
      transform: none;
    }

    .suggestion-form {
      padding: 28px 22px;
    }

    .contact-bottom {
      padding: 30px 25px;
    }

  }

</style>