---
import { getCollection } from "astro:content";
import "../styles/global.css";

const topics = await getCollection("topics");

const latestTopics = [...topics]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4);

const featuredTopics = ["fermi-paradox", "mariana-trench", "ship-of-theseus"]
  .map((slug) => {
    const topic = topics.find((item) => item.id.split("/").pop() === slug);

    return topic;
  })
  .filter((topic): topic is (typeof topics)[number] => topic !== undefined);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>The Catalog — Notes, Obsessions & Other Things</title>
    <meta name="description" content="A cozy corner for curious people." />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <a class="logo" href="/">
            <img src="/logo-icon.svg" alt="The Catalog logo" />
            The Catalog
          </a>
        </div>

        <nav class="sections">
          <a href="/" class="active">Home</a>
          <a href="/discover">Discover</a>
          <a href="/rabbit-holes">Rabbit Holes</a>
          <a href="/random">Random</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <!-- HERO -->

      <section class="hero home-hero">
        <div class="wrap hero-inner">
          <div>
            <span class="kicker"> est. 2026 · notes & miscellany </span>

            <h1>
              A place for things<br />
              worth getting<br />
              <em>curious about.</em>
            </h1>

            <p class="lede">
              Weird facts. Big questions. Tiny obsessions. Stories that send you
              down a rabbit hole at 2am.
            </p>

            <div class="hero-actions">
              <a class="primary-button" href="/discover"> Start exploring → </a>

              <a class="secondary-button" href="/random"> Surprise me </a>
            </div>
          </div>

          <div class="hero-side" aria-hidden="true">
            <div
              class="doodle spin"
              style="top:0; right:50px; width:70px; height:70px;"
            >
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M20 4 L23 15 L34 15 L25 22 L28 33 L20 26 L12 33 L15 22 L6 15 L17 15 Z"
                ></path>
              </svg>
            </div>

            <div
              class="doodle float"
              style="bottom:10px; left:20px; width:44px; height:44px;"
            >
              <svg
                viewBox="0 0 40 40"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M20 30c-6 0-10-4-10-9s4-8 8-8 6 3 6 6-2 5-5 5-4-2-4-4"
                ></path>
              </svg>
            </div>

            <div
              class="doodle float"
              style="top:60px; left:100px; width:26px; height:26px; animation-delay:1.2s;"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2 8 8 2-8 2-2 8-2-8-8-2 8-2z"></path>
              </svg>
            </div>

            <span class="hero-note note-one"> hmm... </span>

            <span class="hero-note note-two"> ↓ this way </span>
          </div>
        </div>
      </section>

      <!-- EXPLORE -->

      <section class="wrap explore-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">browse the catalog</p>
            <h2>Pick something to get lost in.</h2>
          </div>

          <p class="heading-note">
            No particular order. Just things worth keeping.
          </p>
        </div>

        <div class="cat-grid">
          <a
            class="cat-card"
            href="/sections/ocean"
            style="--accent:var(--ocean)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M3 12c3-4 6 4 9 0s6 4 9 0"></path>
                <path d="M3 17c3-4 6 4 9 0s6 4 9 0"></path>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Ocean</h3>

            <p>
              Deep sea mysteries, strange creatures, lost worlds, and everything
              hiding beneath the surface.
            </p>

            <span class="go">Dive in →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/space"
            style="--accent:var(--space)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19 5c-3-2-8-1-11 2s-4 8-2 11c3 2 8 1 11-2s4-8 2-11z"
                ></path>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Space</h3>

            <p>
              Black holes, alien civilizations, cosmic weirdness, and questions
              bigger than Earth.
            </p>

            <span class="go">Look up →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/history"
            style="--accent:var(--history)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M4 19h16"></path>
                <path d="M6 17V7l6-4 6 4v10"></path>
                <path d="M9 17v-5h6v5"></path>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>History</h3>

            <p>
              Ancient civilizations, forgotten people, bizarre events, and
              stories history class skipped.
            </p>

            <span class="go">Go backwards →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/philosophy"
            style="--accent:var(--philosophy)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="12" cy="12" r="8"></circle>
                <path d="M9 9c1-2 4-2 5 0 1 2-1 3-2 4-1 1-1 2-1 3"></path>
                <circle cx="12" cy="19" r=".5" fill="currentColor"></circle>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Philosophy</h3>

            <p>
              Consciousness, existence, morality, reality, and questions with
              annoyingly difficult answers.
            </p>

            <span class="go">Think too hard →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/movies"
            style="--accent:var(--movies)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M3 9h18M8 5v4M16 5v4"></path>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Movies</h3>

            <p>
              Cult classics, hidden details, theories, filmmaking rabbit holes,
              and stories behind the screen.
            </p>

            <span class="go">Press play →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/books"
            style="--accent:var(--books)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 5c-2-1.5-5-2-8-1v14c3-1 6-.5 8 1c2-1.5 5-2-8-1V4c-3-1-6-.5-8 1z"
                ></path>
                <line x1="12" y1="5" x2="12" y2="19"></line>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Books</h3>

            <p>
              Strange stories, unforgettable characters, literary rabbit holes,
              and books worth obsessing over.
            </p>

            <span class="go">Open a book →</span>
          </a>
          <a
            class="cat-card"
            href="/sections/folklores"
            style="--accent:var(--movies)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 5c-2-1.5-5-2-8-1v14c3-1 6-.5 8 1c2-1.5 5-2-8-1V4c-3-1-6-.5-8 1z"
                ></path>
                <line x1="12" y1="5" x2="12" y2="19"></line>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Folk-lores</h3>

            <p>
              Strange stories thar are worth obsessing over.
            </p>

            <span class="go">Read more →</span>
          </a>

          <a
            class="cat-card"
            href="/sections/anime"
            style="--accent:var(--space)"
          >
            <div class="icon-badge">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 17V7l8-4 8 4v10l-8 4-8-4z"></path>
                <circle cx="9" cy="11" r="1"></circle>
                <circle cx="15" cy="11" r="1"></circle>
                <path d="M9 15c2 1 4 1 6 0"></path>
              </svg>
            </div>

            <span class="cat-label">Explore</span>
            <h3>Anime</h3>

            <p>
              Worlds, characters, symbolism, theories, lore, and the shows that
              consume your entire weekend.
            </p>

            <span class="go">Enter the world →</span>
          </a>
        </div>
      </section>

      <!-- LATEST -->

      <section class="wrap latest-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">freshly filed</p>
            <h2>Recently added to the catalog.</h2>
          </div>

          <a href="/discover" class="section-link"> Browse all → </a>
        </div>

        <div class="latest-list">
          {
            latestTopics.map((topic) => {
              const slug = topic.id.split("/").pop();

              return (
                <a class="latest-entry" href={`/topics/${slug}`}>
                  <div class="latest-entry-number">✦</div>

                  <div class="latest-entry-main">
                    <div class="latest-meta">
                      <span>{topic.data.section}</span>

                      <span>
                        {topic.data.publishedAt.toLocaleDateString("en-US", {
                          month: "short",
                          day: "numeric",
                          year: "numeric",
                        })}
                      </span>
                    </div>

                    <h3>{topic.data.title}</h3>

                    <p>{topic.data.description}</p>
                  </div>

                  <span class="latest-arrow">→</span>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- RABBIT HOLE CTA -->

      <section class="wrap rabbit-cta-section">
        <div class="rabbit-cta">
          <div class="rabbit-cta-doodle" aria-hidden="true">
            <span>✦</span>
            <span>·</span>
            <span>✧</span>
          </div>

          <div>
            <p class="eyebrow">still here?</p>

            <h2>
              You might as well<br />
              fall down a rabbit hole.
            </h2>

            <p>
              We've already connected the dots. You just have to follow them.
            </p>
          </div>

          <a href="/rabbit-holes"> Show me the trails → </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p>The Catalog — notes & miscellany.</p>

        <p>
          <a href="/about">About</a>
          <a href="/contact">Suggest a topic</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* HERO */

  .home-hero {
    padding-bottom: 55px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .primary-button,
  .secondary-button {
    display: inline-block;
    padding: 10px 16px;
    border: 2px solid var(--ink);
    border-radius: 7px;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .primary-button {
    background: var(--card);
    color: var(--ink);
    box-shadow: 4px 4px 0 var(--philosophy);
  }

  .secondary-button {
    color: var(--ink-on-purple);
    border-color: rgba(243, 233, 255, 0.45);
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translate(-2px, -2px);
    text-decoration: none;
  }

  .primary-button:hover {
    box-shadow: 6px 6px 0 var(--philosophy);
  }

  .hero-note {
    position: absolute;
    color: var(--ink-on-purple);
    font-family: "Fraunces", serif;
    font-size: 15px;
    font-style: italic;
    opacity: 0.7;
  }

  .note-one {
    top: 100px;
    right: 8px;
    transform: rotate(8deg);
  }

  .note-two {
    bottom: 20px;
    right: 45px;
    transform: rotate(-7deg);
  }

  /* SECTION HEADINGS */

  .featured-section,
  .explore-section,
  .latest-section {
    padding-top: 55px;
    padding-bottom: 70px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 6px;
    color: var(--ink-dim-purple);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    color: var(--ink-on-purple);
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.1;
  }

  .section-link {
    flex-shrink: 0;
    color: var(--ink-on-purple);
    font-size: 13px;
    font-weight: 800;
  }

  .heading-note {
    margin: 0;
    color: var(--ink-dim-purple);
    font-size: 13px;
    font-style: italic;
  }

  /* FEATURED */

  .featured-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 18px;
  }

  .featured-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    justify-content: space-between;
    padding: 25px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 7px 7px 0 var(--accent, var(--philosophy));
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .featured-1 {
    --accent: var(--space);
  }

  .featured-2 {
    --accent: var(--ocean);
  }

  .featured-3 {
    --accent: var(--philosophy);
  }

  .featured-card:nth-child(odd) {
    transform: rotate(-0.45deg);
  }

  .featured-card:nth-child(even) {
    transform: rotate(0.45deg);
  }

  .featured-card:hover {
    transform: translate(-3px, -3px) rotate(0deg);
    box-shadow: 10px 10px 0 var(--accent);
    text-decoration: none;
  }

  .featured-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 35px;
  }

  .featured-number {
    color: var(--ink-dim-card);
    font-family: "Fraunces", serif;
    font-size: 14px;
    font-weight: 700;
  }

  .featured-section {
    padding: 4px 9px;
    background: var(--ink);
    border-radius: 5px;
    color: var(--card);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .featured-card h3 {
    margin-bottom: 9px;
    font-size: 27px;
    line-height: 1.08;
  }

  .featured-card p {
    margin: 0;
    color: var(--ink-dim-card);
    font-size: 14px;
  }

  .featured-arrow {
    margin-top: 25px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* EXPLORE */

  .explore-section {
    border-top: 1px dashed rgba(243, 233, 255, 0.25);
  }

  /* LATEST */

  .latest-section {
    border-top: 1px dashed rgba(243, 233, 255, 0.25);
  }

  .latest-list {
    display: flex;
    flex-direction: column;
    border-top: 2px solid rgba(243, 233, 255, 0.2);
  }

  .latest-entry {
    display: grid;
    grid-template-columns: 45px 1fr 35px;
    gap: 15px;
    align-items: center;
    padding: 20px 8px;
    border-bottom: 2px solid rgba(243, 233, 255, 0.15);
    color: var(--ink-on-purple);
    text-decoration: none;
    transition:
      padding-left 0.15s ease,
      background 0.15s ease;
  }

  .latest-entry:hover {
    padding-left: 15px;
    background: rgba(255, 255, 255, 0.035);
    text-decoration: none;
  }

  .latest-entry-number {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--philosophy);
    font-size: 19px;
  }

  .latest-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 3px;
    color: var(--ink-dim-purple);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .latest-entry h3 {
    margin-bottom: 3px;
    color: var(--ink-on-purple);
    font-size: 21px;
  }

  .latest-entry p {
    margin: 0;
    color: var(--ink-dim-purple);
    font-size: 13px;
  }

  .latest-arrow {
    color: var(--ink-dim-purple);
    font-size: 20px;
    font-weight: 700;
    text-align: right;
  }

  /* RABBIT HOLE CTA */

  .rabbit-cta-section {
    padding-top: 20px;
    padding-bottom: 90px;
  }

  .rabbit-cta {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    overflow: hidden;
    padding: 42px 45px;
    background: var(--bg-deep);
    border: 2.5px solid var(--ink);
    border-radius: 10px;
    box-shadow: 8px 8px 0 var(--ocean);
  }

  .rabbit-cta h2 {
    margin-bottom: 8px;
    color: var(--ink-on-purple);
    font-size: clamp(27px, 4vw, 38px);
    line-height: 1.08;
  }

  .rabbit-cta p:last-child {
    margin: 0;
    color: var(--ink-dim-purple);
    font-size: 14px;
  }

  .rabbit-cta > a {
    flex-shrink: 0;
    padding: 11px 17px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 7px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--ocean);
    transition: transform 0.15s ease;
  }

  .rabbit-cta > a:hover {
    transform: translate(-2px, -2px);
    text-decoration: none;
  }

  .rabbit-cta-doodle {
    position: absolute;
    top: -35px;
    right: 35px;
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--ink-on-purple);
    font-family: "Fraunces", serif;
    font-size: 38px;
    opacity: 0.25;
    transform: rotate(12deg);
  }

  .rabbit-cta-doodle span:nth-child(2) {
    font-size: 20px;
  }

  /* MOBILE */

  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
    }

    .featured-card:first-child {
      grid-column: 1 / -1;
      min-height: 230px;
    }
  }

  @media (max-width: 760px) {
    .hero-note {
      display: none;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .heading-note {
      display: none;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card:first-child {
      grid-column: auto;
    }

    .featured-card {
      min-height: 220px;
    }

    .latest-entry {
      grid-template-columns: 30px 1fr 25px;
      gap: 10px;
    }

    .latest-entry p {
      display: none;
    }

    .rabbit-cta {
      align-items: flex-start;
      flex-direction: column;
      padding: 32px 25px;
    }

    .rabbit-cta-doodle {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .home-hero {
      padding-top: 44px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .featured-section,
    .explore-section,
    .latest-section {
      padding-top: 40px;
      padding-bottom: 55px;
    }

    .featured-card:nth-child(n) {
      transform: none;
    }
  }

  .logo img {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
</style>
