---
import { getCollection } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const sections = [
    {
      name: "Ocean",
      slug: "ocean",
      description:
        "Deep sea mysteries, strange creatures, lost worlds, and everything hiding beneath the surface.",
      accent: "var(--ocean)",
    },
    {
      name: "Space",
      slug: "space",
      description:
        "Black holes, alien civilizations, cosmic weirdness, and questions bigger than Earth.",
      accent: "var(--space)",
    },
    {
      name: "History",
      slug: "history",
      description:
        "Ancient civilizations, forgotten people, bizarre events, and stories history class skipped.",
      accent: "var(--history)",
    },
    {
      name: "Philosophy",
      slug: "philosophy",
      description:
        "Consciousness, existence, morality, reality, and questions with annoyingly difficult answers.",
      accent: "var(--philosophy)",
    },
    {
      name: "Movies",
      slug: "movies",
      description:
        "Cult classics, hidden details, theories, filmmaking rabbit holes, and stories behind the screen.",
      accent: "var(--movies)",
    },
    {
      name: "Books",
      slug: "books",
      description:
        "Strange stories, unforgettable characters, literary rabbit holes, and books worth obsessing over.",
      accent: "var(--books)",
    },
    {
      name: "Anime",
      slug: "anime",
      description:
        "Worlds, characters, symbolism, theories, lore, and the shows that consume your entire weekend.",
      accent: "var(--space)",
    },
  ];

  const topics = await getCollection("topics");

  return sections.map((section) => ({
    params: {
      section: section.slug,
    },
    props: {
      section,
      topics: topics
        .filter((topic) => topic.data.section === section.name)
        .sort(
          (a, b) =>
            b.data.publishedAt.getTime() -
            a.data.publishedAt.getTime()
        ),
    },
  }));
}

const { section: currentSection, topics: sectionTopics } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{currentSection.name} — The Catalog</title>

    <meta
      name="description"
      content={currentSection.description}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <a class="logo" href="/">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 5c-2-1.5-5-2-8-1v14c3-1 6-.5 8 1c2-1.5 5-2-8-1V4c-3-1-6-.5-8 1z" />
              <line x1="12" y1="5" x2="12" y2="19" />
            </svg>

            The Catalog
          </a>
        </div>

        <nav class="sections">
          <a href="/">Home</a>
          <a href="/discover">Discover</a>
          <a href="/rabbit-holes">Rabbit Holes</a>
          <a href="/random">Random</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="wrap section-page">
      <div class="section-heading">
        <a class="back-link" href="/">
          ← Back to The Catalog
        </a>

        <h1>Things worth getting curious about.</h1>

        <p class="section-description">
          {currentSection.description}
        </p>
      </div>

      {
        sectionTopics.length > 0 ? (
          <>
            <p class="entry-count">
              {sectionTopics.length}
              {sectionTopics.length === 1 ? " entry" : " entries"}
              {" "}in this corner of the catalog.
            </p>

            <div class="topic-grid">
              {sectionTopics.map((topic) => {
                const slug = topic.id.split("/").pop();

                return (
                  <article class="topic-card">
                    <p class="topic-section">
                      {topic.data.section}
                    </p>

                    <h2>{topic.data.title}</h2>

                    <p class="topic-description">
                      {topic.data.description}
                    </p>

                    <div class="topic-tags">
                      {topic.data.tags.map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </div>

                    <a href={`/topics/${slug}`}>
                      Open entry →
                    </a>
                  </article>
                );
              })}
            </div>
          </>
        ) : (
          <div class="empty-state">
            <div class="empty-icon">✦</div>

            <h2>Nothing here yet.</h2>

            <p>
              This corner of the catalog is still waiting
              for its first entry.
            </p>

            <a href="/contact">
              Suggest a topic →
            </a>
          </div>
        )
      }
    </main>

    <footer>
      <div class="wrap">
        <p>
          The Catalog — a running catalog of curiosities.
        </p>

        <p>
          <a href="/about">About</a>
          <a href="/contact">Suggest a topic</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .section-page {
    padding-top: 60px;
    padding-bottom: 90px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 25px;
    font-size: 14px;
    font-weight: 800;
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 35px;
  }

  .section-heading .kicker {
    display: inline-block;
    margin-bottom: 15px;
    padding: 5px 12px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 6px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--section-accent);
  }

  .section-heading h1 {
    margin-bottom: 15px;
    font-size: clamp(34px, 5vw, 52px);
  }

  .section-description {
    max-width: 55ch;
    color: var(--ink-dim-purple);
    font-size: 17px;
  }

  .entry-count {
    margin-bottom: 25px;
    color: var(--ink-dim-purple);
    font-size: 14px;
    font-weight: 700;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }

  .topic-card {
    padding: 25px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    box-shadow: 6px 6px 0 var(--philosophy);
  }

  .topic-card:nth-child(even) {
    transform: rotate(0.5deg);
  }

  .topic-card:nth-child(odd) {
    transform: rotate(-0.5deg);
  }

  .topic-card .topic-section {
    display: inline-block;
    margin: 0 0 12px;
    padding: 3px 9px;
    background: var(--ink);
    border-radius: 5px;
    color: var(--card);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .topic-card h2 {
    margin-bottom: 10px;
    font-size: 24px;
  }

  .topic-card .topic-description {
    color: var(--ink-dim-card);
    font-size: 15px;
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0;
  }

  .topic-tags span {
    color: var(--ink-dim-card);
    font-size: 12px;
  }

  .topic-card a {
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
  }

  .empty-state {
    max-width: 650px;
    padding: 45px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 10px;
    color: var(--ink);
    text-align: center;
    box-shadow: 7px 7px 0 var(--space);
    transform: rotate(-0.5deg);
  }

  .empty-icon {
    margin-bottom: 10px;
    font-size: 32px;
  }

  .empty-state h2 {
    margin-bottom: 10px;
    font-size: 30px;
  }

  .empty-state p {
    margin-bottom: 20px;
    color: var(--ink-dim-card);
  }

  .empty-state a {
    color: var(--ink);
    font-size: 14px;
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topic-card {
      transform: none;
    }

    .empty-state {
      padding: 30px 22px;
    }
  }
</style>