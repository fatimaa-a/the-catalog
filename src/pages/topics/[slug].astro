---
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const topics = await getCollection("topics");

  return topics.map((topic) => ({
    params: {
      slug: topic.id.split("/").pop(),
    },
    props: {
      topic,
    },
  }));
}

const { topic } = Astro.props;

if (!topic) {
  throw new Error("Topic not found");
}

const { Content } = await render(topic);

const allTopics = await getCollection("topics");

const relatedTopics = allTopics
  .filter(
    (item) => item.id !== topic.id && item.data.section === topic.data.section,
  )
  .slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{topic.data.title} — The Catalog</title>

    <meta name="description" content={topic.data.description} />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="brand">
          <a class="logo" href="/">
            <img src="/logo-icon.svg" alt="The Catalog logo" />
            The Catalog
          </a>
        </div>

        <nav class="sections">
          <a href="/">Home</a>
          <a href="/discover">Discover</a>
          <a href="/rabbit-holes">Rabbit Holes</a>
          <a href="/random">Random</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="topic-page">
      <div class="topic-decoration decoration-left" aria-hidden="true">
        <span>✦</span>
        <span>⌁</span>
        <span>✧</span>
      </div>

      <div class="topic-decoration decoration-right" aria-hidden="true">
        <span>✧</span>
        <span>✦</span>
        <span>⌁</span>
      </div>

      <div class="topic-wrap">
        <a
          class="back-tab"
          href={`/sections/${topic.data.section.toLowerCase()}`}
        >
          ← {topic.data.section}
        </a>

        <article class="entry-paper">
          <div class="paper-top">
            <span class="entry-number"> THE CATALOG · ENTRY </span>

            <span class="entry-date">
              {
                topic.data.publishedAt.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              }
            </span>
          </div>

          <header class="entry-header">
            <p class="entry-section">
              {topic.data.section}
            </p>

            <h1>{topic.data.title}</h1>

            <p class="entry-description">
              {topic.data.description}
            </p>
          </header>

          <div class="entry-divider">
            <span>✦</span>
            <span></span>
            <span>✦</span>
          </div>

          <div class="entry-content">
            <Content />
          </div>

          <div class="entry-end">
            <span>✦</span>
            <p>End of this chapter.</p>
            <span>✦</span>
          </div>
        </article>

        <section class="continue-section">
          <div class="continue-heading">
            <p class="eyebrow">the catalog continues</p>

            <h2>Still curious?</h2>

            <p>You could stop here. But where's the fun in that?</p>
          </div>

          {
            relatedTopics.length > 0 && (
              <div class="related-grid">
                {relatedTopics.map((related, index) => {
                  const relatedSlug = related.id.split("/").pop();

                  return (
                    <a
                      class:list={["related-card", `related-${index + 1}`]}
                      href={`/topics/${relatedSlug}`}
                    >
                      <span class="related-number">0{index + 1}</span>

                      <div>
                        <p>{related.data.section}</p>
                        <h3>{related.data.title}</h3>
                      </div>

                      <span class="related-arrow">↗</span>
                    </a>
                  );
                })}
              </div>
            )
          }

          <a class="discover-more" href="/discover">
            Browse the whole catalog →
          </a>
        </section>
      </div>
    </main>

    <footer>
      <div class="wrap">
        <p>The Catalog — a running catalog of curiosities.</p>

        <p>
          <a href="/about">About</a>
          <a href="/contact">Suggest a topic</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .topic-page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: 55px 20px 100px;
  }

  .topic-wrap {
    position: relative;
    z-index: 2;
    max-width: 1150px;
    margin: 0 auto;
  }

  .back-tab {
    display: inline-block;
    margin: 0 0 -2px 28px;
    padding: 8px 16px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    color: var(--ink);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .back-tab:hover {
    text-decoration: underline;
  }

  .entry-paper {
    position: relative;
    padding: 38px 48px 50px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 4px 10px 10px 10px;
    color: var(--ink);
    box-shadow: 10px 10px 0 var(--space);
    transform: rotate(-0.25deg);
  }

  .entry-paper::before {
    content: "";
    position: absolute;
    top: 0;
    left: 22px;
    bottom: 0;
    width: 1px;
    background: rgba(201, 123, 82, 0.18);
  }

  .entry-paper::after {
    content: "";
    position: absolute;
    top: 0;
    right: 26px;
    width: 45px;
    height: 3px;
    background: var(--space);
    transform: rotate(-2deg);
  }

  .paper-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 42px;
    color: var(--ink-dim-card);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .entry-number {
    font-family: "Fraunces", serif;
    font-size: 12px;
  }

  .entry-header {
    max-width: 100%;
  }

  .entry-section {
    display: inline-block;
    margin: 0 0 15px;
    padding: 5px 11px;
    background: var(--ink);
    border-radius: 5px;
    color: var(--card);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .entry-header h1 {
    margin: 0 0 18px;
    color: var(--ink);
    font-size: clamp(36px, 5.5vw, 54px);
    line-height: 1.08;
  }

  .entry-description {
    max-width: 70ch;
    margin: 0;
    color: var(--ink-dim-card);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
  }

  .entry-tags span {
    padding: 4px 8px;
    border: 1.5px solid rgba(58, 42, 80, 0.22);
    border-radius: 5px;
    color: var(--ink-dim-card);
    font-size: 11px;
    font-weight: 700;
  }

  .entry-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 42px 0 38px;
  }

  .entry-divider span:first-child,
  .entry-divider span:last-child {
    color: var(--space);
    font-size: 16px;
  }

  .entry-divider span:nth-child(2) {
    flex: 1;
    height: 1px;
    background: rgba(58, 42, 80, 0.18);
  }

  /* ARTICLE */

  .entry-content {
    width: 100%;
    max-width: none;
    margin: 0;
    font-family: "Nunito", sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #5b4b68;
  }

  .entry-content :global(p),
  .entry-content :global(ul),
  .entry-content :global(ol),
  .entry-content :global(blockquote),
  .entry-content :global(hr) {
    max-width: none;
  }

  .entry-content :global(p) {
    margin: 0 0 22px;
  }

  .entry-content :global(h2) {
    margin: 38px 0 12px;
    color: #463652;
    font-size: 25px;
    line-height: 1.25;
  }

  .entry-content :global(h3) {
    margin: 30px 0 10px;
    color: #463652;
    font-size: 20px;
    line-height: 1.3;
  }

  .entry-content :global(strong) {
    color: #4c3b59;
    font-weight: 800;
  }

  .entry-content :global(a) {
    color: #65507a;
    font-weight: 800;
    text-decoration-thickness: 1.5px;
  }

  .entry-content :global(blockquote) {
    margin: 30px 0;
    padding: 14px 20px;
    background: var(--card-alt);
    border-left: 4px solid var(--philosophy);
    color: #665671;
    font-family: "Fraunces", serif;
    font-size: 18px;
    line-height: 1.5;
  }

  .entry-content :global(ul),
  .entry-content :global(ol) {
    margin: 0 0 24px;
    padding-left: 25px;
  }

  .entry-content :global(li) {
    margin-bottom: 8px;
  }

  .entry-content :global(hr) {
    margin: 45px 0;
    border: none;
    border-top: 1px dashed rgba(58, 42, 80, 0.25);
  }

  /* END OF ENTRY */

  .entry-end {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    margin-top: 55px;
    color: var(--ink-dim-card);
  }

  .entry-end p {
    margin: 0;
    font-family: "Fraunces", serif;
    font-size: 15px;
    font-style: italic;
  }

  .entry-end span {
    color: var(--space);
    font-size: 14px;
  }

  /* DECORATIONS */

  .topic-decoration {
    position: absolute;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 35px;
    color: var(--ink-on-purple);
    opacity: 0.65;
    pointer-events: none;
  }

  .topic-decoration span {
    display: block;
    font-family: "Fraunces", serif;
  }

  .decoration-left {
    top: 180px;
    left: 7%;
    transform: rotate(-12deg);
  }

  .decoration-left span:nth-child(1) {
    font-size: 42px;
    animation: floatOne 4s ease-in-out infinite;
  }

  .decoration-left span:nth-child(2) {
    margin-left: 28px;
    font-size: 35px;
    animation: floatTwo 5s ease-in-out infinite;
  }

  .decoration-left span:nth-child(3) {
    margin-left: 5px;
    font-size: 20px;
  }

  .decoration-right {
    top: 330px;
    right: 7%;
    transform: rotate(14deg);
  }

  .decoration-right span:nth-child(1) {
    margin-left: 25px;
    font-size: 22px;
  }

  .decoration-right span:nth-child(2) {
    font-size: 48px;
    animation: floatTwo 4.5s ease-in-out infinite;
  }

  .decoration-right span:nth-child(3) {
    margin-left: 35px;
    font-size: 34px;
  }

  @keyframes floatOne {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }

    50% {
      transform: translateY(-9px) rotate(8deg);
    }
  }

  @keyframes floatTwo {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(10px);
    }
  }

  /* CONTINUE READING */

  .continue-section {
    padding-top: 85px;
  }

  .continue-heading {
    margin-bottom: 28px;
  }

  .continue-heading h2 {
    margin: 0 0 5px;
    font-size: 36px;
  }

  .continue-heading p:last-child {
    margin: 0;
    color: var(--ink-dim-purple);
    font-size: 15px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .related-card {
    position: relative;
    min-height: 175px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    background: var(--card);
    border: 2.5px solid var(--ink);
    border-radius: 9px;
    color: var(--ink);
    text-decoration: none;
    box-shadow: 5px 5px 0 var(--accent);
    transition: transform 0.15s ease;
  }

  .related-1 {
    --accent: var(--ocean);
    transform: rotate(-0.6deg);
  }

  .related-2 {
    --accent: var(--philosophy);
    transform: rotate(0.6deg);
  }

  .related-3 {
    --accent: var(--history);
    transform: rotate(-0.4deg);
  }

  .related-card:hover {
    transform: translateY(-5px) rotate(0deg);
  }

  .related-number {
    align-self: flex-end;
    color: var(--ink-dim-card);
    font-family: "Fraunces", serif;
    font-size: 18px;
  }

  .related-card p {
    margin: 0 0 5px;
    color: var(--ink-dim-card);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .related-card h3 {
    font-size: 21px;
    line-height: 1.15;
  }

  .related-arrow {
    position: absolute;
    right: 20px;
    bottom: 18px;
    font-size: 20px;
  }

  .discover-more {
    display: block;
    width: fit-content;
    margin: 35px auto 0;
    color: var(--ink-on-purple);
    font-size: 13px;
    font-weight: 800;
  }

  /* RESPONSIVE */

  @media (max-width: 1000px) {
    .topic-decoration {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .topic-page {
      padding: 35px 14px 70px;
    }

    .back-tab {
      margin-left: 12px;
    }

    .entry-paper {
      padding: 28px 25px 40px;
      box-shadow: 6px 6px 0 var(--space);
      transform: none;
    }

    .entry-paper::before {
      left: 12px;
    }

    .paper-top {
      margin-bottom: 35px;
    }

    .entry-header h1 {
      font-size: clamp(34px, 10vw, 46px);
    }

    .entry-description {
      font-size: 16px;
      line-height: 1.45;
    }

    .entry-content {
      width: 100%;
      max-width: none;
      font-size: 16px;
      line-height: 1.6;
    }

    .entry-content :global(p) {
      max-width: none;
    }

    .entry-content :global(h2) {
      margin: 32px 0 10px;
      font-size: 21px;
      line-height: 1.25;
    }

    .entry-content :global(h3) {
      font-size: 19px;
    }

    .entry-content :global(blockquote) {
      padding: 12px 15px;
      font-size: 18px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .related-card {
      transform: none;
    }
  }

  .logo img {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  
</style>