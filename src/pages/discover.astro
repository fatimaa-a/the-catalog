---
import { getCollection } from "astro:content";
import "../styles/global.css";

const topics = await getCollection("topics");

const sortedTopics = [...topics].sort(
  (a, b) =>
    b.data.publishedAt.getTime() -
    a.data.publishedAt.getTime()
);

const allTags = [
  ...new Set(
    topics.flatMap((topic) => topic.data.tags)
  ),
].sort();

const selectedTag = Astro.url.searchParams.get("tag") || "";

const searchQuery =
  Astro.url.searchParams.get("q") || "";

const normalizedQuery =
  searchQuery.trim().toLowerCase();

const filteredTopics = sortedTopics.filter((topic) => {

  const matchesTag =
    !selectedTag ||
    topic.data.tags.some(
      (tag) =>
        tag.toLowerCase() ===
        selectedTag.toLowerCase()
    );

  const searchableText = [
    topic.data.title,
    topic.data.description,
    topic.data.section,
    ...topic.data.tags,
  ]
    .join(" ")
    .toLowerCase();

  const matchesSearch =
    !normalizedQuery ||
    searchableText.includes(normalizedQuery);

  return matchesTag && matchesSearch;
});

const hasFilters =
  Boolean(selectedTag) ||
  Boolean(normalizedQuery);

const featuredTopics = hasFilters
  ? filteredTopics.slice(0, 4)
  : sortedTopics.slice(0, 4);

const latestTopics = hasFilters
  ? filteredTopics.slice(4)
  : sortedTopics.slice(4);
---

<html lang="en">
  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>Discover — The Catalog</title>

    <meta
      name="description"
      content="Explore strange ideas, fascinating stories, impossible questions, and rabbit holes from The Catalog."
    />

  </head>


  <body>

    <header class="site-header">

      <div class="wrap">

        <div class="brand">

          <a class="logo" href="/">
            <img src="/logo-icon.svg" alt="The Catalog logo" />
            The Catalog
          </a>

        </div>


        <nav class="sections">

          <a href="/">
            Home
          </a>

          <a
            href="/discover"
            class="active"
          >
            Discover
          </a>

          <a href="/rabbit-holes">
            Rabbit Holes
          </a>

          <a href="/random">
            Random
          </a>

          <a href="/about">
            About
          </a>

          <a href="/contact">
            Contact
          </a>

        </nav>

      </div>

    </header>


    <main class="wrap discover-page">


      <!-- HERO -->

      <section class="discover-hero">

        <p class="kicker">
          open the catalog
        </p>

        <h1>
          Find something<br />
          to obsess over.
        </h1>

        <p>
          You don't need a plan. Pick a subject,
          search for something specific, or just
          start wandering.
        </p>

      </section>


      <!-- SEARCH -->

      <section class="search-section">

        <form
          class="search-form"
          method="get"
          action="/discover"
        >

          <div class="search-box">

            <span class="search-icon">
              ⌕
            </span>

            <input
              type="search"
              name="q"
              value={searchQuery}
              placeholder="Search the catalog..."
              aria-label="Search the catalog"
            />

          </div>


          {
            selectedTag && (
              <input
                type="hidden"
                name="tag"
                value={selectedTag}
              />
            )
          }


          <button type="submit">
            Search
          </button>

        </form>


        {
          hasFilters && (
            <div class="active-filters">

              <span>
                Looking for:
              </span>

              {
                normalizedQuery && (
                  <strong>
                    "{searchQuery}"
                  </strong>
                )
              }

              {
                selectedTag && (
                  <strong>
                    #{selectedTag}
                  </strong>
                )
              }

              <a href="/discover">
                Clear ×
              </a>

            </div>
          )
        }

      </section>


      <!-- RESULTS -->

      {
        hasFilters ? (

          <section class="results-section">

            <div class="section-title">

              <div>

                <p class="eyebrow">
                  the catalog says
                </p>

                <h2>
                  {filteredTopics.length}
                  {
                    filteredTopics.length === 1
                      ? " result"
                      : " results"
                  }
                </h2>

              </div>

            </div>


            {
              filteredTopics.length > 0 ? (

                <div class="results-grid">

                  {
                    filteredTopics.map((topic) => {

                      const slug =
                        topic.id
                          .split("/")
                          .pop();

                      return (

                        <article class="result-card">

                          <div class="result-top">

                            <span class="section-label">
                              {topic.data.section}
                            </span>

                          </div>


                          <h3>
                            {topic.data.title}
                          </h3>


                          <p>
                            {topic.data.description}
                          </p>


                          <div class="result-bottom">

                            <div class="tags">

                              {
                                topic.data.tags
                                  .slice(0, 3)
                                  .map((tag) => (

                                    <a
                                      href={`/discover?tag=${encodeURIComponent(tag)}`}
                                    >
                                      #{tag}
                                    </a>

                                  ))
                              }

                            </div>


                            <a
                              class="read-link"
                              href={`/topics/${slug}`}
                            >
                              Read →
                            </a>

                          </div>

                        </article>

                      );

                    })
                  }

                </div>

              ) : (

                <div class="no-results">

                  <span>
                    ?
                  </span>

                  <h2>
                    Nothing turned up.
                  </h2>

                  <p>
                    Either the catalog doesn't have
                    it yet, or you've discovered a
                    wonderfully specific question.
                  </p>

                  <a href="/contact">
                    Suggest it to us →
                  </a>

                </div>

              )
            }

          </section>

        ) : (

          <>

            <!-- FEATURED -->

            <section class="featured-section">

              <div class="section-title">

                <div>

                  <p class="eyebrow">
                    ★ handpicked curiosities
                  </p>

                  <h2>
                    Start here.
                  </h2>

                </div>

                <span>
                  {featuredTopics.length}
                  curiosities
                </span>

              </div>


              <div class="featured-grid">

                {
                  featuredTopics.map(
                    (topic, index) => {

                      const slug =
                        topic.id
                          .split("/")
                          .pop();

                      return (

                        <article
                          class:list={[
                            "featured-card",
                            `featured-${index + 1}`,
                          ]}
                        >

                          <div class="card-top">

                            <span class="section-label">
                              {topic.data.section}
                            </span>

                            <span class="card-number">
                              0{index + 1}
                            </span>

                          </div>


                          <h3>
                            {topic.data.title}
                          </h3>


                          <p>
                            {topic.data.description}
                          </p>


                          <div class="card-bottom">

                            <div class="tags">

                              {
                                topic.data.tags
                                  .slice(0, 3)
                                  .map((tag) => (
                                    <a
                                      href={`/discover?tag=${encodeURIComponent(tag)}`}
                                    >
                                      #{tag}
                                    </a>
                                  ))
                              }

                            </div>


                            <a
                              href={`/topics/${slug}`}
                            >
                              Explore →
                            </a>

                          </div>

                        </article>

                      );

                    }
                  )
                }

              </div>

            </section>


            <!-- LATEST -->

            <section class="latest-section">

              <div class="section-title">

                <div>

                  <p class="eyebrow">
                    the newest additions
                  </p>

                  <h2>
                    Fresh from the catalog.
                  </h2>

                </div>

              </div>


              <div class="latest-list">

                {
                  latestTopics.map((topic) => {

                    const slug =
                      topic.id
                        .split("/")
                        .pop();

                    return (

                      <article class="latest-card">

                        <div class="latest-info">

                          <span class="section-label">
                            {topic.data.section}
                          </span>

                          <h3>
                            {topic.data.title}
                          </h3>

                          <p>
                            {topic.data.description}
                          </p>

                        </div>


                        <div class="latest-action">

                          <div class="tags">

                            {
                              topic.data.tags
                                .slice(0, 3)
                                .map((tag) => (

                                  <a
                                    href={`/discover?tag=${encodeURIComponent(tag)}`}
                                  >
                                    #{tag}
                                  </a>

                                ))
                            }

                          </div>


                          <a
                            href={`/topics/${slug}`}
                          >
                            Read entry →
                          </a>

                        </div>

                      </article>

                    );

                  })
                }

              </div>

            </section>

          </>

        )
      }



    </main>


    <footer>

      <div class="wrap">

        <p>
          The Catalog — notes & miscellany
        </p>

        <p>

          <a href="/about">
            About
          </a>

          <a href="/contact">
            Suggest a topic
          </a>

        </p>

      </div>

    </footer>

  </body>
</html>


<style>

  .discover-page {
    padding-top: 65px;
    padding-bottom: 100px;
  }


  /* HERO */

  .discover-hero {
    max-width: 720px;

    margin-bottom: 55px;
  }

  .discover-hero .kicker {
    display: inline-block;

    margin-bottom: 18px;

    padding: 5px 12px;

    background: var(--card);

    border: 2px solid var(--ink);
    border-radius: 6px;

    color: var(--ink);

    font-size: 12px;
    font-weight: 800;

    text-transform: uppercase;

    box-shadow: 4px 4px 0 var(--space);
  }

  .discover-hero h1 {
    margin-bottom: 20px;

    font-size: clamp(42px, 6vw, 68px);

    line-height: 1.05;
  }

  .discover-hero > p:last-child {
    max-width: 50ch;

    color: var(--ink-dim-purple);

    font-size: 18px;
    font-weight: 600;
  }


  /* SEARCH */

  .search-section {
    margin-bottom: 65px;
  }

  .search-form {
    display: flex;

    gap: 10px;

    max-width: 850px;
  }

  .search-box {
    position: relative;

    flex: 1;
  }

  .search-icon {
    position: absolute;

    top: 50%;
    left: 14px;

    color: var(--ink-dim-card);

    font-size: 23px;

    transform: translateY(-53%);
  }

  .search-box input {
    width: 100%;

    padding: 14px 16px 14px 43px;

    background: var(--card);

    border: 2.5px solid var(--ink);
    border-radius: 7px;

    color: var(--ink);

    font-family: "Nunito", sans-serif;

    font-size: 14px;

    outline: none;

    box-shadow: 4px 4px 0 var(--space);
  }

  .search-box input:focus {
    box-shadow: 5px 5px 0 var(--philosophy);
  }

  .search-box input::placeholder {
    color: var(--ink-dim-card);
  }

  .search-form button {
    padding: 0 20px;

    background: var(--ink);

    border: 2.5px solid var(--ink);
    border-radius: 7px;

    color: var(--card);

    font-family: "Nunito", sans-serif;

    font-size: 13px;
    font-weight: 800;

    cursor: pointer;
  }

  .search-form button:hover {
    background: var(--bg-deep);
  }

  .active-filters {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 7px;

    margin-top: 18px;

    color: var(--ink-dim-purple);

    font-size: 13px;
  }

  .active-filters strong {
    padding: 4px 8px;

    background: var(--card);

    border: 1.5px solid var(--ink);

    border-radius: 5px;

    color: var(--ink);

    font-size: 12px;
  }

  .active-filters a {
    margin-left: 5px;

    font-size: 12px;
    font-weight: 800;
  }


  /* SECTION TITLES */

  .section-title {
    display: flex;

    align-items: end;
    justify-content: space-between;

    gap: 20px;

    margin-bottom: 25px;
  }

  .section-title h2 {
    font-size: 34px;
  }

  .section-title > span {
    color: var(--ink-dim-purple);

    font-size: 13px;
    font-weight: 800;
  }

  .eyebrow {
    margin: 0 0 5px;

    color: var(--ink-dim-purple);

    font-size: 11px;
    font-weight: 800;

    letter-spacing: .08em;

    text-transform: uppercase;
  }


  /* FEATURED */

  .featured-section {
    margin-bottom: 85px;
  }

  .featured-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 22px;
  }

  .featured-card {
    min-height: 290px;

    display: flex;

    flex-direction: column;

    padding: 26px;

    background: var(--card);

    border: 2.5px solid var(--ink);
    border-radius: 10px;

    color: var(--ink);

    box-shadow: 7px 7px 0 var(--accent);

    transition:
      transform .15s ease,
      box-shadow .15s ease;
  }

  .featured-card:nth-child(odd) {
    transform: rotate(-.6deg);
  }

  .featured-card:nth-child(even) {
    transform: rotate(.6deg);
  }

  .featured-card:hover {
    transform: translateY(-4px) rotate(0deg);
  }

  .featured-1 {
    --accent: var(--space);
  }

  .featured-2 {
    --accent: var(--ocean);
  }

  .featured-3 {
    --accent: var(--movies);
  }

  .featured-4 {
    --accent: var(--history);
  }

  .card-top {
    display: flex;

    align-items: center;
    justify-content: space-between;

    margin-bottom: 30px;
  }

  .section-label {
    display: inline-block;

    padding: 4px 9px;

    background: var(--ink);

    border-radius: 5px;

    color: var(--card);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .05em;

    text-transform: uppercase;
  }

  .card-number {
    color: var(--ink-dim-card);

    font-family: "Fraunces", serif;

    font-size: 20px;
  }

  .featured-card h3 {
    margin-bottom: 10px;

    font-size: 27px;

    line-height: 1.15;
  }

  .featured-card > p {
    max-width: 48ch;

    margin: 0;

    color: var(--ink-dim-card);

    font-size: 15px;
  }

  .card-bottom {
    display: flex;

    align-items: end;
    justify-content: space-between;

    gap: 15px;

    margin-top: auto;

    padding-top: 25px;
  }


  /* COMMON TAGS */

  .tags {
    display: flex;

    flex-wrap: wrap;

    gap: 6px;
  }

  .tags a {
    color: var(--ink-dim-card);

    font-size: 11px;
    font-weight: 700;

    text-decoration: none;
  }

  .tags a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .card-bottom > a,
  .latest-action > a,
  .read-link {
    color: var(--ink);

    font-size: 13px;
    font-weight: 800;
  }


  /* LATEST */

  .latest-section {
    margin-bottom: 90px;
  }

  .latest-list {
    display: flex;

    flex-direction: column;

    gap: 14px;
  }

  .latest-card {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 30px;

    padding: 22px 25px;

    background: var(--card);

    border: 2px solid var(--ink);
    border-radius: 8px;

    color: var(--ink);
  }

  .latest-card:nth-child(even) {
    transform: rotate(.25deg);
  }

  .latest-info {
    min-width: 0;
  }

  .latest-info h3 {
    margin: 8px 0 5px;

    font-size: 22px;
  }

  .latest-info p {
    max-width: 65ch;

    margin: 0;

    color: var(--ink-dim-card);

    font-size: 14px;
  }

  .latest-action {
    flex-shrink: 0;

    display: flex;

    flex-direction: column;

    align-items: end;

    gap: 12px;
  }


  /* RESULTS */

  .results-section {
    margin-bottom: 80px;
  }

  .results-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 18px;
  }

  .result-card {
    display: flex;

    flex-direction: column;

    min-height: 270px;

    padding: 24px;

    background: var(--card);

    border: 2.5px solid var(--ink);
    border-radius: 9px;

    color: var(--ink);

    box-shadow: 5px 5px 0 var(--space);

    transition:
      transform .15s ease,
      box-shadow .15s ease;
  }

  .result-card:nth-child(3n + 2) {
    box-shadow: 5px 5px 0 var(--ocean);
  }

  .result-card:nth-child(3n) {
    box-shadow: 5px 5px 0 var(--movies);
  }

  .result-card:hover {
    transform: translate(-2px, -2px);
  }

  .result-top {
    margin-bottom: 24px;
  }

  .result-card h3 {
    margin-bottom: 10px;

    font-size: 23px;

    line-height: 1.15;
  }

  .result-card > p {
    margin: 0;

    color: var(--ink-dim-card);

    font-size: 14px;
  }

  .result-bottom {
    display: flex;

    align-items: end;
    justify-content: space-between;

    gap: 12px;

    margin-top: auto;

    padding-top: 22px;
  }


  /* NO RESULTS */

  .no-results {
    padding: 55px 30px;

    background: var(--card);

    border: 2.5px dashed var(--ink);

    border-radius: 9px;

    color: var(--ink);

    text-align: center;
  }

  .no-results > span {
    display: block;

    margin-bottom: 8px;

    font-family: "Fraunces", serif;

    font-size: 38px;
  }

  .no-results h2 {
    margin-bottom: 7px;

    font-size: 29px;
  }

  .no-results p {
    max-width: 50ch;

    margin: 0 auto 20px;

    color: var(--ink-dim-card);

    font-size: 14px;
  }

  .no-results a {
    color: var(--ink);

    font-size: 13px;
    font-weight: 800;
  }


  /* TAGS */

  .tag-section {
    padding: 45px;

    background: var(--bg-deep);

    border: 2.5px solid var(--ink);

    border-radius: 10px;

    box-shadow: 8px 8px 0 var(--philosophy);
  }

  .tag-heading {
    margin-bottom: 28px;
  }

  .tag-heading h2 {
    margin-bottom: 5px;

    color: var(--ink-on-purple);

    font-size: 34px;
  }

  .tag-heading p:last-child {
    margin: 0;

    color: var(--ink-dim-purple);

    font-size: 15px;
  }

  .tag-cloud {
    display: flex;

    flex-wrap: wrap;

    gap: 10px;
  }

  .tag-cloud a {
    padding: 8px 13px;

    background: var(--card);

    border: 2px solid var(--ink);

    border-radius: 7px;

    color: var(--ink);

    font-size: 13px;
    font-weight: 800;

    text-decoration: none;

    transition:
      transform .15s ease,
      box-shadow .15s ease;
  }

  .tag-cloud a:hover,
  .tag-cloud a.selected {
    transform: translate(-2px, -2px);

    box-shadow: 4px 4px 0 var(--space);
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .results-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  @media (max-width: 700px) {

    .discover-page {
      padding-top: 45px;
    }

    .search-form {
      flex-direction: column;
    }

    .search-form button {
      min-height: 46px;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      transform: none !important;
    }

    .latest-card {
      align-items: flex-start;

      flex-direction: column;
    }

    .latest-action {
      align-items: flex-start;
    }

    .results-grid {
      grid-template-columns: 1fr;
    }

    .tag-section {
      padding: 30px 22px;
    }

  }

  .logo img {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }

</style>